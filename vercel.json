{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install --no-audit --no-fund",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": { "maxDuration": 30, "includeFiles": "servidor/**" }
  },
  "redirects": [
    { "source": "/", "destination": "/frontend/html/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/painel/:pagina*", "destination": "/api/index" },
    { "source": "/auth/:acao*", "destination": "/api/index" },
    { "source": "/relatorios/:formato*", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
