{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Vitrine estatica: sem dependencias'",
  "buildCommand": "bash scripts/vercel-vitrine.sh",
  "outputDirectory": "vitrine",
  "redirects": [
    { "source": "/", "destination": "/frontend/html/index.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
